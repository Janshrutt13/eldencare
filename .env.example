# Required: Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Explicit trusted origin for confirmation emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only credentials. Never prefix secrets with NEXT_PUBLIC_.
# Required only for notification processing and the local seed script.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Set a supported text model ID from your Google AI Studio project.
GEMINI_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# At least 32 random characters; protects GET /api/cron/reminders.
CRON_SECRET=
REMINDER_UPCOMING_MINUTES=30
REMINDER_OVERDUE_MINUTES=60
REMINDER_APPOINTMENT_MINUTES=1440
# Optional CLI seed settings; never needed in Vercel.
DEMO_PROJECT_REF=
DEMO_ACCOUNT_PASSWORD=
# Default .invalid addresses cannot receive email. Use an owned domain for delivery tests.
DEMO_EMAIL_DOMAIN=eldencare.invalid
# Optional normal sign-in email picker. Never exposes or auto-fills the password.
DEMO_ACCOUNT_PICKER_ENABLED=false
